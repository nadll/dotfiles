{
    "[python]": {
        "editor.bracketPairColorization.enabled": false,
        "editor.guides.bracketPairs": false,
        "editor.insertSpaces": true,
        // 4 to match what Ruff/black write (PEP 8); was 2
        "editor.tabSize": 4,
        // needs the Ruff extension (charliermarsh.ruff); replaces "python.formatting.provider", which VS Code dropped
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSaveMode": "file",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        },
    },
    "[html]": {
        "editor.defaultFormatter": "vscode.html-language-features"
    },
    "window.zoomLevel": 0,
    // diff view also shows whitespace-only changes, so it matches what gets committed
    // (files.trimTrailingWhitespace can change many lines on save)
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.bracketPairColorization.enabled": true,
    // existing files keep their own indentation; new/empty files use editor.tabSize (2, 4 in [python]). Was false
    "editor.detectIndentation": true,
    "editor.fontSize": 14,
    "editor.guides.bracketPairs": true,
    "editor.minimap.enabled": false,
    "editor.multiCursorModifier": "ctrlCmd",
    "editor.renderControlCharacters": true,
    // show trailing spaces as dots
    "editor.renderWhitespace": "trailing",
    "editor.rulers": [
        80,
        120
    ],
    "editor.showFoldingControls": "always",
    "editor.snippetSuggestions": "top",
    // animated scrolling in the editor and in lists/trees (explorer, Source Control)
    "editor.smoothScrolling": true,
    "workbench.list.smoothScrolling": true,
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "emmet.includeLanguages": {
        "erb": "html"
    },
    "emmet.showSuggestionsAsSnippets": true,
    "emmet.triggerExpansionOnTab": true,
    "explorer.confirmDelete": false,
    // no pop-ups suggesting the extensions a repo recommends (.vscode/extensions.json)
    "extensions.ignoreRecommendations": true,
    "files.exclude": {
        "__pycache__": true,
        "_site": true,
        ".asset-cache": true,
        ".bundle": true,
        ".ipynb_checkpoints": true,
        ".pytest_cache": true,
        ".sass-cache": true,
        ".svn": true,
        "**/.DS_Store": true,
        "**/*.egg-info": true,
        "**/.git": true,
        "build": true,
        "coverage": true,
        "dist": true,
        "log": true,
        "node_modules": true,
        "public/packs": true,
        "tmp": true
    },
    "files.hotExit": "off",
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "files.watcherExclude": {
        "**/audits/**": true,
        "**/coverage/**": true,
        "**/log/**": true,
        "**/node_modules/**": true,
        "**/tmp/**": true,
        "**/vendor/**": true
    },
    // built-in Source Control panel and git gutter markers (was false, which turned them off)
    "git.enabled": true,
    // fetch in the background so the status bar shows when the branch is behind the remote
    "git.autofetch": true,
    // don't add an AI "Co-authored-by" trailer to commit messages (Copilot chat/agent)
    "git.addAICoAuthor": "off",
    // a subfolder of a repo opened on its own still gets Source Control, without asking first
    "git.openRepositoryInParentFolders": "always",
    // who changed the current line and when, in gray at the end of the line
    "git.blame.editorDecoration.enabled": true,
    // merge conflicts open in the 3-pane merge editor (incoming / current / result)
    "git.mergeEditor": true,
    "notebook.diff.ignoreMetadata": true,
    "notebook.lineNumbers": "on",
    "notebook.markup.fontSize": 13,
    "python.analysis.typeCheckingMode": "basic",
    //"python.defaultInterpreterPath": "~/.pyenv/shims/python",
    // removed from VS Code in 2023, the formatter is now set per language ([python] editor.defaultFormatter)
    //"python.formatting.provider": "black",
    "python.languageServer": "Pylance",
    //"python.linting.enabled": true,
    //"python.linting.flake8Enabled": false,
    //"python.linting.pylintEnabled": true,
    "python.terminal.activateEnvironment": false,
    // no A/B experiments in the Python extension
    "python.experiments.enabled": false,
    // from the old Ruby extension (rebornix.ruby, deprecated); Shopify's Ruby LSP ignores it
    // and runs RuboCop by itself when the project uses it
    //"ruby.lint": {
    //    "rubocop": true
    //},
    "search.exclude": {
        // Inherits all glob patterns from the `files.exclude` setting.
        "**/.venv": true
    },
    "telemetry.telemetryLevel": "off",
    // privacy: telemetryLevel off doesn't cover these
    // no A/B experiments downloaded from Microsoft
    "workbench.enableExperiments": false,
    // Settings search stays local (otherwise sent to a Microsoft service)
    "workbench.settings.enableNaturalLanguageSearch": false,
    // no surveys or feedback prompts
    "telemetry.feedback.enabled": false,
    "window.restoreWindows": "none",
    // needs the Vim extension (vscodevim.vim), not used for now
    //"vim.smartRelativeLine": true,
    "window.newWindowDimensions": "maximized",
    "workbench.editor.enablePreview": true,
    "workbench.settings.editor": "json",
    "workbench.settings.openDefaultSettings": true,
    "workbench.settings.useSplitJSON": true,
    "workbench.startupEditor": "newUntitledFile",
    // where the panel (terminal, problems, output) opens: bottom, left or right
    "workbench.panel.defaultLocation": "bottom",
    "workbench.colorCustomizations": {
        "titleBar.activeBackground": "#ffb70097"
    },
    // Nerd Font so the p10k prompt icons render. brew/Brewfile installs it as "MesloLGS Nerd Font";
    // "MesloLGS NF" is the name of p10k's own copy, used if that one is installed instead
    "terminal.integrated.fontFamily": "'MesloLGS NF', 'MesloLGS Nerd Font', monospace",
    // a single file from an untrusted place (e.g. ~/Downloads) opens in the current trusted window, no prompt.
    // Fine with the current extensions; switch to "prompt" if extensions that run code from config files
    // found next to the file (ESLint's eslint.config.js, RuboCop's .rubocop.yml require) get installed
    "security.workspace.trust.untrustedFiles": "open",
    "claudeCode.preferredLocation": "panel",
    "claudeCode.useTerminal": true,
    // skip the Claude Code extension welcome screen
    "claudeCode.hideOnboarding": true,
    "workbench.colorTheme": "Tomorrow Night Blue",
    "update.mode": "start",
    "update.showPostInstallInfo": true,
    // Material Icon Theme (pkief.material-icon-theme, in brew/Brewfile); was Great Icons, few updates lately
    //"workbench.iconTheme": "vscode-great-icons",
    "workbench.iconTheme": "material-icon-theme",
}
