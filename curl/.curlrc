# curl settings, linked to ~/.curlrc by curl/configure.sh
# Every curl run reads this file, unless it is called with -q (or --disable) as first option.

# Downloads to a file (curl -O, -o) show a simple ##### bar instead of the table of numbers.
# No effect with -s/--silent, so scripts like `curl -fsSL ... | bash` are unchanged.
progress-bar
