# Machine-specific hosts and keys, not tracked in this repo. At the top so it can
# override the settings below: ssh uses the first value it finds for each option.
Include ~/.ssh/config.local

Host *
  # use only identifies provided by ssh_config. Don't use identities provided by ssh-agent
  IdentitiesOnly yes

  # disconnect after 5 minute of inactivity
  ServerAliveInterval 60
  ServerAliveCountMax 5

  IgnoreUnknown UseKeychain
  PermitLocalCommand yes

  # reduce the default connect timeout to 5s
  ConnectTimeout 5

  # store new server names in ~/.ssh/known_hosts hashed, so the file doesn't list where you connect
  # (existing entries stay readable; hash them with: ssh-keygen -H, which keeps known_hosts.old)
  # find or remove a host with: ssh-keygen -F <host> / ssh-keygen -R <host>
  # side effect: zsh no longer offers these hosts after `ssh <Tab>` (hosts in ssh config still are)
  HashKnownHosts yes

  # OSX specific
  # Use passwords stored in Keychain
  # plus, automatically add keys to ssh-agent when private key is used for the first time
  AddKeysToAgent yes
  UseKeychain yes

Host *
  IdentityFile ~/.ssh/id_rsa
